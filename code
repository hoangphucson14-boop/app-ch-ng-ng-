            banner.classList.remove('hidden');

            // 2. Cập nhật Badge Trạng Thái
            const badge = document.getElementById('status-badge');
            badge.className = "px-2.5 py-1 rounded-md text-xs font-semibold bg-red-500/20 text-red-400 border border-red-500/30 animate-pulse";
            badge.innerText = "PHÁT HIỆN NGÃ!";

            // 3. Đổi Icon Marker trên bản đồ sang màu Đỏ
            const emergencyIcon = L.divIcon({
                className: 'custom-div-icon',
                html: `<div style="background-color: #ef4444; width: 26px; height: 26px; border-radius: 50%; border: 3px solid white; box-shadow: 0 0 15px rgba(239, 68, 68, 1);" class="pulse-danger"></div>`,
                iconSize: [26, 26
