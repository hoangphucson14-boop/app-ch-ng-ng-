        let emergencyAudioContext = null;
        let isEmergencyActive = false;
        let audioOscillator = null;
        let currentCoords = { lat: 20.86513, lng: 106.68383 }; // Tọa độ mặc định (Hải Phòng / Hà Nội / VN)

        window.onload = function() {
            initMap();
            addLog("System initialized", "Hệ thống giám sát KHKT sẵn sàng.");
        };

        // Khởi tạo bản đồ Leaflet
        function initMap() {
            map = L.map('map').setView([currentCoords.lat, currentCoords.lng], 16);

            // Sử dụng OpenStreetMap tile layer
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            // Icon tùy chỉnh cho người dùng
            const defaultIcon = L.divIcon({
                className: 'custom-div-icon',
                html: `<div style="background-color: #6366f1; width: 22px; height: 22px; border-radius: 50%; border: 3px solid white; shadow: 0 0 10px rgba(0,0,0,0.5);"></div>`,
                iconSize: [22, 22],
                iconAnchor: [11, 11]
            });

            userMarker = L.marker([currentCoords.lat, currentCoords.lng], { icon: defaultIcon }).addTo(map);
            userMarker.bindPopup("<b>Vị trí thiết bị</b><br>Trạng thái: An toàn").openPopup();
        }

        // --- 2. XỬ LÝ ÂM THANH CẢNH BÁO (AUDIO SYNTHESIZER NO EXTERNAL URL) ---
        function startSoundSiren() {
            try {
                if (!emergencyAudioContext) {
                    emergencyAudioContext = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (emergencyAudioContext.state === 'suspended') {
                    emergencyAudioContext.resume();
                }

                if (audioOscillator) return; // Đã chạy rồi

                audioOscillator = emergencyAudioContext.createOscillator();
                const gainNode = emergencyAudioContext.createGain();

                audioOscillator.type = 'sawtooth';
                
                // Tần số còi hú cảnh báo biến thiên (Siren effect)
                let highFrequency = true;
                audioOscillator.frequency.setValueAtTime(800, emergencyAudioContext.currentTime);

                const sirenInterval = setInterval(() => {
                    if (!isEmergencyActive || !audioOscillator) {
                        clearInterval(sirenInterval);
                        return;
                    }
                    if (highFrequency) {
                        audioOscillator.frequency.exponentialRampToValueAtTime(500, emergencyAudioContext.currentTime + 0.3);
                    } else {
                        audioOscillator.frequency.exponentialRampToValueAtTime(1000, emergencyAudioContext.currentTime + 0.3);
                    }
                    highFrequency = !highFrequency;
                }, 400);

                audioOscillator.connect(gainNode);
                gainNode.connect(emergencyAudioContext.destination);
                audioOscillator.start();
            } catch (e) {
                console.log("Audio not allowed without user interaction first", e);
            }
        }

        function stopSoundSiren() {
            if (audioOscillator) {
                audioOscillator.stop();
                audioOscillator.disconnect();
                audioOscillator = null;
            }
        }

        // --- 3. LOGIC KÍCH HOẠT & TẮT CẢNH BÁO NGÃ ---
        function triggerSimulatedFall() {
